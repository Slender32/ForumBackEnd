<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.slender.forumbackend.mapper.ArticleRewardMapper">
    <select id="selectByArticleAndUser" resultType="com.slender.forumbackend.model.entity.article.relation.ArticleReward">
        SELECT reward_id, article_id, user_id, amount, create_time FROM article_rewards
        WHERE article_id = #{articleId} AND user_id = #{userId}
    </select>
</mapper>
